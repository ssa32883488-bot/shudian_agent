# 应用
APP_NAME=数电教育智能体
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL
# PostgreSQL（正式）；无 PG 时可临时改用 sqlite:///./data/shudian_agent.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/shudian_agent

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_QUESTIONS=question_bank

# LLM 云端 API（DeepSeek；OpenAI 兼容）
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_OCR_MODEL=deepseek-flash
DEEPSEEK_MOCK=true

# BGE 真模型（开）。本机建议 small + RERANK_VIA_EMBED；大内存可换 bge-m3 并关 VIA_EMBED
BGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
BGE_RERANKER_MODEL=BAAI/bge-small-zh-v1.5
BGE_USE_REAL_MODEL=true
BGE_RERANK_VIA_EMBED=true
BGE_DEVICE=cpu

# 图谱：本项目不用 Docker，Neo4j 默认关，走 JSON
NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=shudian123

# 题库：软召回 → 智能体匹配确认；硬阈值留给工具兼容
HIT_CANDIDATE_THRESHOLD=0.82
HIT_SCORE_THRESHOLD=0.95
MATCH_ACCEPT_THRESHOLD=0.75
TEXTBOOK_RAG_SCORE_THRESHOLD=0.95
REFLOW_MODE=manual
AUTHORITY_VALIDATE_THRESHOLD=0.7
DECISION_MAKER_USE_LLM=true

# 强制真实登录（false）；仅本地临时调试可 true
AUTH_DISABLED=false
DEMO_CLASS_CODE=DEMO01
REDIS_URL=redis://127.0.0.1:6379/0
MEMORY_SUMMARY_EVERY_N=10
MEMORY_KEEP_RECENT_K=6

# Agent 防死循环 + 多题分流（墙钟默认 3 分钟）
AGENT_MAX_ITERATIONS=8
AGENT_WALL_TIMEOUT_SEC=180
AGENT_DIRECT_WALL_TIMEOUT_SEC=180
AGENT_IDLE_TIMEOUT_SEC=90
AGENT_MAX_OUTPUT_CHARS=2800
AGENT_MAX_DRAW_CALLS=3
AGENT_MAX_RETRIEVE_CALLS=2
AGENT_MAX_SEARCH_CALLS=2
AGENT_REPEAT_ACTION_LIMIT=3
MULTI_QUESTION_ANSWER_LIMIT=2
MULTI_QUESTION_CHAR_THRESHOLD=1800

# 绘图运行时（详见 docs/定稿-绘图子系统.md）
# 自检：python -m scripts.check_draw_runtime
# DRAW_RUNTIME_ROOT=   # 可选；默认 shudian_agent/runtime；Docker=/app/runtime
NODE_BIN=node
# JAVA_HOME=             # 或保证 PATH 有 java（勿依赖本机硬编码路径）
# MSI：DIGITAL_JAR 或 app/tools/draw/digital_dig/vendor/Digital.jar
# DIGITAL_JAR=F:/code/digital-circuit-poc/digital/Digital.jar

# MinIO（对象存储；本地 compose 默认如下，服务器改 endpoint/密钥/域名）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shudian-textbook
MINIO_SECURE=false
# 浏览器访问前缀 = {endpoint}/{bucket}；上线改为 https://你的域名/... 
MEDIA_BASE_URL=http://127.0.0.1:9000/shudian-textbook
