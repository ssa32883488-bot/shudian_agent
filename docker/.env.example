# ============================================================
# 精简部署环境变量模板（复制为 .env 后填写）
#
#   cp .env.example .env
#   编辑 DEEPSEEK_KEY=你的 DeepSeek Key
#   ./bootstrap_slim.sh   或  .\bootstrap_slim.ps1
# ============================================================

# 【必填】DeepSeek API Key（或其它 OpenAI 兼容网关的 Key）
# 申请：https://platform.deepseek.com/
DEEPSEEK_KEY=

MIMO_API_BASE=https://api.deepseek.com/v1
MIMO_MODEL=deepseek-chat
MIMO_OCR_MODEL=deepseek-chat
MIMO_MOCK=false

# 浏览器媒体前缀（nginx 反代 /media → backend；backend 再读 MinIO/本地）
MEDIA_BASE_URL=/media

AUTH_DISABLED=false
AUTH_SALT=please-change-this-salt-in-production
DEMO_CLASS_CODE=DEMO01

HIT_SCORE_THRESHOLD=0.95
REFLOW_MODE=manual

DRAW_RUNTIME_ROOT=/app/runtime
NODE_BIN=node
AGENT_MAX_DRAW_CALLS=3

# —— 基础设施（slim compose 默认已启用）——
POSTGRES_PASSWORD=postgres
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shudian-textbook

NEO4J_ENABLED=false
BGE_USE_REAL_MODEL=false
