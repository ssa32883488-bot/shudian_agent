{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shudian.local/ir/wave_ir.schema.json",
  "title": "WaveformIR",
  "description": "教材波形语义（渲染走教材风 timing renderer，不强制 Schematex timing）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "signals"],
  "properties": {
    "schema_version": { "const": "wave_ir_v1" },
    "diagram_type": { "const": "waveform" },
    "title": { "type": "string" },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "wave"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "wave": {
            "type": "string",
            "description": "每位一格：0/1/. 等；各信号等长"
          }
        }
      }
    }
  }
}
