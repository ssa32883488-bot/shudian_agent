logic "ex_6_4_3" style: iec
input A, B, CLK
output Y, Z, Q1, Q0
nA = NOT(A)
nB = NOT(B)
nQ1 = NOT(Q1)
nQ0 = NOT(Q0)
d1a = AND(Q1, nA)
d1b = AND(d1a, nB)
d1c = AND(nQ1, nQ0)
d1d = AND(d1c, A)
d1e = AND(Q0, B)
d1f = OR(d1b, d1d)
D1 = OR(d1f, d1e)
d0a = AND(nQ1, nQ0)
d0b = AND(d0a, B)
d0c = AND(Q0, nA)
d0d = AND(d0c, nB)
D0 = OR(d0b, d0d)
Q1 = DFF(D1, CLK)
Q0 = DFF(D0, CLK)
ya = AND(Q1, B)
yb = AND(Q1, A)
yc = AND(Q0, A)
yd = OR(ya, yb)
Y = OR(yd, yc)
Z = AND(Q1, A)
