logic "ex_6_2_3" style: iec
input A, CLK
output Y, Q1, Q2
nQ1 = NOT(FF1)
FF1 = DFF(nQ1, CLK)
x1 = XOR(FF1, A)
D2 = XOR(x1, FF2)
FF2 = DFF(D2, CLK)
nA = NOT(A)
t1a = AND(nA, FF1)
t1 = AND(t1a, FF2)
nQ1b = NOT(FF1)
nQ2 = NOT(FF2)
t2a = AND(A, nQ1b)
t2 = AND(t2a, nQ2)
Y = OR(t1, t2)
Q1 <- FF1
Q2 <- FF2
